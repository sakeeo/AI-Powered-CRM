{
  "name": "crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d --wait && node scripts/init-storage.mjs",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && npm run infra:up",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:test:setup": "node scripts/test-db.mjs",
    "test:e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "worker": "tsx src/worker/index.ts",
    "loadtest": "node scripts/load-test.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.102",
    "@ai-sdk/google": "^4.0.117",
