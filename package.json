    "@casl/ability": "^7.1.2",
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/react": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^7.0.5",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "ai": "^7.0.169",
    "better-auth": "^1.7.20",
    "bullmq": "^6.7.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.5.0",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-markdown": "^9.0.1",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.0",
    "resend": "^6.38.0",
    "sanitize-html": "^2.18.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
