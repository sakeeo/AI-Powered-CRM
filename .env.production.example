# Salin menjadi .env.production di server (JANGAN di-commit). Buat nilai acak yang kuat:
#   openssl rand -base64 32
APP_DOMAIN=crm.contoh-perusahaan.com
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_ACAK
REDIS_PASSWORD=GANTI_DENGAN_PASSWORD_ACAK
S3_BUCKET=crm-files
S3_ACCESS_KEY=GANTI_ACCESS_KEY
S3_SECRET_KEY=GANTI_SECRET_KEY_MIN_8_KARAKTER
BETTER_AUTH_SECRET=GANTI_openssl_rand_base64_32
ENCRYPTION_KEY=GANTI_openssl_rand_base64_32
REQUIRE_EMAIL_VERIFICATION=false
# Untuk backup (scripts/backup.sh)
BACKUP_PASSPHRASE=GANTI_PASSPHRASE_BACKUP_PANJANG
