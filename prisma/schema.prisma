// Konvensi data (PRD §7.4) — berlaku untuk semua model bisnis:
//  - id            : UUID v7 (urut waktu), kolom `uuid`
//  - organization_id: wajib pada setiap record bisnis (tenant); tambahkan @@index([organizationId])
//  - created_at / updated_at (UTC), created_by / updated_by (nullable, id user)
//  - deleted_at    : soft delete bila diperlukan
//  - uang          : Decimal(18,2) + kolom `currency` (ISO 4217), jangan Float
//  - nama tabel/kolom snake_case via @@map/@map; model PascalCase, field camelCase

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth & organisasi (Better Auth + plugin Organization).
// Id dibuat oleh database (advanced.database.generateId = false di src/lib/auth.ts).
// Nama field mengikuti kebutuhan Better Auth; kolom di-map ke snake_case.
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions        Session[]
  accounts        Account[]
  members         Member[]
  invitations     Invitation[]
  teamMemberships TeamMember[]

  @@map("users")
}

model Session {
  id                   String   @id @default(uuid(7)) @db.Uuid
  expiresAt            DateTime @map("expires_at") @db.Timestamptz(3)
  token                String   @unique
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  userId               String   @map("user_id") @db.Uuid
  activeOrganizationId String?  @map("active_organization_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

/// Tenant root. Satu-satunya model bisnis tanpa organization_id.
model Organization {
  id              String    @id @default(uuid(7)) @db.Uuid
  name            String
  slug            String    @unique
  logo            String?
  metadata        String?
  /// Profil organisasi (SET-01)
  timezone        String    @default("Asia/Jakarta")
  defaultCurrency String    @default("IDR") @map("default_currency") @db.VarChar(3)
  dateFormat      String    @default("dd/MM/yyyy") @map("date_format")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  members           Member[]
  invitations       Invitation[]
  teams             Team[]
  auditLogs         AuditLog[]
  connectors        TenantConnector[]
  aiCallLogs        AiCallLog[]
  inboundWebhook    InboundWebhook?
  webhookDeliveries WebhookDelivery[]
  dealStageHistory  DealStageHistory[]
  activities        Activity[]
  companies         Company[]
  contacts          Contact[]
  contactCompanies  ContactCompany[]
  leadSources       LeadSource[]
  leads             Lead[]
  pipelines         Pipeline[]
  pipelineStages    PipelineStage[]
  deals             Deal[]

  @@map("organizations")
}

model Member {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  role           String    @default("member")
  /// false = dinonaktifkan: tidak bisa mengakses organisasi, data historis tetap ada
  active         Boolean   @default(true)
  deactivatedAt  DateTime? @map("deactivated_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("members")
}

model Invitation {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  email          String
  role           String?
  status         String   @default("pending")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  inviterId      String   @map("inviter_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

/// Tim penjualan (SET-04). Dipakai untuk kondisi akses Sales Manager (plan 1.3).
model Team {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamMember[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("teams")
}

model TeamMember {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  teamId         String   @map("team_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("team_members")
}

/// Jejak audit perubahan penting (SET-10). Append-only: tidak pernah di-update/hapus oleh aplikasi.
model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  before         Json?
  after          Json?
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}

/// Integrasi pihak ketiga per tenant (Connector Hub). Rahasia hanya di `configEncrypted`
/// (AES-256-GCM, lihat src/lib/crypto.ts) dan TIDAK PERNAH dikirim ke client / log / audit.
model TenantConnector {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  /// ai_gemini | ai_openai | ai_anthropic | ai_openrouter | email_resend | email_smtp | ...
  type            String
  configEncrypted String    @map("config_encrypted")
  /// Petunjuk kunci yang aman ditampilkan, mis. `sk-...abcd`
  maskedHint      String?   @map("masked_hint")
  /// Pengaturan non-rahasia, mis. {"model": "gpt-4.1-mini"}
  settings        Json?
  /// active | error | disabled
  status          String    @default("active")
  isDefault       Boolean   @default(false) @map("is_default")
  lastTestedAt    DateTime? @map("last_tested_at") @db.Timestamptz(3)
  lastTestOk      Boolean?  @map("last_test_ok")
  lastTestError   String?   @map("last_test_error")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy       String?   @map("created_by") @db.Uuid
  updatedBy       String?   @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type])
  @@index([organizationId])
  @@map("tenant_connectors")
}

/// Metadata pemanggilan AI saja (fitur, waktu, status) — isi prompt/response TIDAK disimpan (decisions.md #10).
model AiCallLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  feature        String
  provider       String
  model          String?
  status         String
  durationMs     Int      @map("duration_ms")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("ai_call_logs")
}

/// Perusahaan pelanggan/prospek (CONT-02).
model Company {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  industry       String?
  website        String?
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String?
  /// Catatan internal (CONT-10)
  notes          String?
  ownerId        String?   @map("owner_id") @db.Uuid
  mergedIntoId   String?   @map("merged_into_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     ContactCompany[]
  deals        Deal[]

  activities Activity[]

  @@index([organizationId, name])
  @@index([organizationId, ownerId])
  @@map("companies")
}

/// Individu yang berhubungan dengan bisnis (CONT-01).
model Contact {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  name            String
  email           String?
  phone           String?
  /// Telepon dinormalisasi (hanya digit, 0→62) untuk deteksi duplikat
  phoneNormalized String?   @map("phone_normalized")
  jobTitle        String?   @map("job_title")
  address         String?
  city            String?
  country         String?
  notes           String?
  ownerId         String?   @map("owner_id") @db.Uuid
  /// Diisi bila record ini digabung ke record lain (merge manual)
  mergedIntoId    String?   @map("merged_into_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy       String?   @map("created_by") @db.Uuid
  updatedBy       String?   @map("updated_by") @db.Uuid
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companies    ContactCompany[]
  deals        Deal[]

  activities Activity[]

  @@index([organizationId, name])
  @@index([organizationId, email])
  @@index([organizationId, phoneNormalized])
  @@index([organizationId, ownerId])
  @@map("contacts")
}

/// Relasi eksplisit many-to-many contact ↔ company (decisions #2).
model ContactCompany {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  contactId      String   @map("contact_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  /// Jabatan contact di company ini
  roleTitle      String?  @map("role_title")
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([contactId, companyId])
  @@index([organizationId])
  @@index([companyId])
  @@map("contact_companies")
}

/// Sumber lead yang dapat dikonfigurasi organisasi (SET-06, LEAD-03).
model LeadSource {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  isActive       Boolean  @default(true) @map("is_active")
  /// Sumber sistem (mis. "Website" untuk webhook) tidak dapat dihapus.
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("lead_sources")
}

/// Calon pelanggan sebelum dikualifikasi/dikonversi (PRD §4.2). Status lead BUKAN tahap deal.
model Lead {
  id                 String    @id @default(uuid(7)) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  name               String
  email              String?
  phone              String?
  phoneNormalized    String?   @map("phone_normalized")
  companyName        String?   @map("company_name")
  /// Kebutuhan pelanggan (LEAD-06)
  needs              String?
  budget             Decimal?  @db.Decimal(18, 2)
  currency           String    @default("IDR") @db.VarChar(3)
  /// low | medium | high
  urgency            String?
  notes              String?
  /// new | contacted | qualified | unqualified
  status             String    @default("new")
  unqualifiedReason  String?   @map("unqualified_reason")
  sourceId           String?   @map("source_id") @db.Uuid
  ownerId            String?   @map("owner_id") @db.Uuid
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz(3)
  /// Diisi saat konversi (plan 1.7)
  convertedAt        DateTime? @map("converted_at") @db.Timestamptz(3)
  convertedContactId String?   @map("converted_contact_id") @db.Uuid
  convertedCompanyId String?   @map("converted_company_id") @db.Uuid
  convertedDealId    String?   @map("converted_deal_id") @db.Uuid
  mergedIntoId       String?   @map("merged_into_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy          String?   @map("created_by") @db.Uuid
  updatedBy          String?   @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source       LeadSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  activities Activity[]

  @@index([organizationId, status])
  @@index([organizationId, ownerId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, email])
  @@index([organizationId, phoneNormalized])
  @@map("leads")
}

/// Pipeline penjualan (DEAL-06). Skema mendukung banyak pipeline; UI MVP mengelola satu default.
model Pipeline {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  isDefault      Boolean   @default(false) @map("is_default")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       PipelineStage[]
  deals        Deal[]

  @@index([organizationId])
  @@map("pipelines")
}

/// Tahap aktif pipeline. Won/Lost BUKAN stage — itu outcome terminal pada Deal.status (PRD §4.4).
model PipelineStage {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  pipelineId     String    @map("pipeline_id") @db.Uuid
  name           String
  position       Int
  /// Probabilitas default (0–100) untuk deal pada tahap ini
  probability    Int       @default(0)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline     Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals        Deal[]

  @@index([organizationId])
  @@index([pipelineId, position])
  @@map("pipeline_stages")
}

/// Peluang penjualan (DEAL-01…05). Nilai uang Decimal(18,2) + currency; tidak pernah float.
model Deal {
  id                String    @id @default(uuid(7)) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  title             String
  pipelineId        String    @map("pipeline_id") @db.Uuid
  stageId           String    @map("stage_id") @db.Uuid
  /// open | won | lost
  status            String    @default("open")
  value             Decimal   @default(0) @db.Decimal(18, 2)
  currency          String    @default("IDR") @db.VarChar(3)
  expectedCloseDate DateTime? @map("expected_close_date") @db.Date
  /// Override probabilitas deal; null = ikut probabilitas stage
  probability       Int?
  contactId         String?   @map("contact_id") @db.Uuid
  companyId         String?   @map("company_id") @db.Uuid
  ownerId           String?   @map("owner_id") @db.Uuid
  notes             String?
  /// Diisi saat Won/Lost (plan 1.10)
  closedAt          DateTime? @map("closed_at") @db.Timestamptz(3)
  lostReason        String?   @map("lost_reason")
  lostCategory      String?   @map("lost_category")
  /// Asal deal bila dikonversi dari lead (plan 1.7)
  sourceLeadId      String?   @map("source_lead_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy         String?   @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline     Pipeline           @relation(fields: [pipelineId], references: [id])
  stage        PipelineStage      @relation(fields: [stageId], references: [id])
  stageHistory DealStageHistory[]
  contact      Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company      Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)

  activities Activity[]

  @@index([organizationId, status, stageId])
  @@index([organizationId, ownerId])
  @@index([organizationId, contactId])
  @@index([organizationId, companyId])
  @@index([organizationId, expectedCloseDate])
  @@map("deals")
}

/// Endpoint webhook masuk per tenant (CONN-05). Secret disimpan terenkripsi (AES-GCM) karena dibutuhkan
/// untuk memverifikasi HMAC; nilai asli hanya ditampilkan sekali saat dibuat/dirotasi.
model InboundWebhook {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @unique @map("organization_id") @db.Uuid
  /// Bagian acak dari URL publik; bukan rahasia kriptografis (otentikasi memakai signature).
  publicId        String    @unique @map("public_id")
  secretEncrypted String    @map("secret_encrypted")
  maskedHint      String    @map("masked_hint")
  isActive        Boolean   @default(true) @map("is_active")
  lastReceivedAt  DateTime? @map("last_received_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy       String?   @map("created_by") @db.Uuid
  updatedBy       String?   @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("inbound_webhooks")
}

/// Log penerimaan webhook (tanpa payload mentah — hanya hasil & alasan penolakan).
model WebhookDelivery {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// accepted | invalid_signature | invalid_payload | inactive | rate_limited
  status         String
  httpStatus     Int      @map("http_status")
  error          String?
  leadId         String?  @map("lead_id") @db.Uuid
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("webhook_deliveries")
}

/// Riwayat perpindahan stage deal (DEAL-10): siapa, kapan, dari → ke. Append-only.
model DealStageHistory {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  fromStageId    String?  @map("from_stage_id") @db.Uuid
  toStageId      String   @map("to_stage_id") @db.Uuid
  changedBy      String?  @map("changed_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId, dealId, createdAt(sort: Desc)])
  @@map("deal_stage_history")
}

/// Aktivitas & task (ACT-01…06). Relasi ke record bisnis eksplisit (satu FK per tipe, bukan polymorphic string).
/// `ownerId` = assignee (nama kolom disamakan agar kondisi kepemilikan CASL berlaku).
model Activity {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// task | call | meeting | email | note
  type           String
  subject        String
  /// HTML hasil editor (Tiptap), disanitasi di server
  body           String?
  /// open | done | cancelled
  status         String    @default("open")
  dueAt          DateTime? @map("due_at") @db.Timestamptz(3)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)
  ownerId        String?   @map("owner_id") @db.Uuid
  leadId         String?   @map("lead_id") @db.Uuid
  contactId      String?   @map("contact_id") @db.Uuid
  companyId      String?   @map("company_id") @db.Uuid
  dealId         String?   @map("deal_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, dueAt])
  @@index([organizationId, ownerId, status])
  @@index([organizationId, leadId, createdAt(sort: Desc)])
  @@index([organizationId, contactId, createdAt(sort: Desc)])
  @@index([organizationId, companyId, createdAt(sort: Desc)])
  @@index([organizationId, dealId, createdAt(sort: Desc)])
  @@map("activities")
}
