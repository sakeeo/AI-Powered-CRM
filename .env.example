POSTGRES_PASSWORD=password
DATABASE_URL="postgresql://crm_user:password@localhost:5434/crm_dev?schema=public"

REDIS_URL="redis://localhost:6380"
S3_ENDPOINT="http://localhost:9100"
S3_REGION="us-east-1"
S3_BUCKET="crm-files"
S3_ACCESS_KEY="crm_minio"
S3_SECRET_KEY="change-me-min-8-chars"

# Better Auth — buat secret dengan: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-random-string-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
REQUIRE_EMAIL_VERIFICATION="false"
# "true" = pendaftaran publik selalu terbuka (mode SaaS). Default "false": pendaftaran hanya untuk
# setup awal (sebelum ada Owner) dan calon anggota yang punya undangan.
PUBLIC_SIGNUP="false"

# Master key enkripsi API key connector (32 byte base64): openssl rand -base64 32
ENCRYPTION_KEY="CHANGE_ME_base64_of_32_random_bytes______="

# Opsional — sinkronisasi Google Calendar/Gmail (buat OAuth client "Web" di Google Cloud Console).
# Redirect URI: <BETTER_AUTH_URL>/api/integrations/google/callback
# Scope: calendar.events, gmail.readonly (sensitif/restricted; perlu verifikasi Google untuk produksi publik).
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
